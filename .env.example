# ============================================
# S3 兼容存储配置
# ============================================
# S3 服务接入点 URL
S3_ENDPOINT=https://s3.example.com
# S3 存储桶名称
S3_BUCKET=your-bucket-name
# S3 访问密钥 ID
S3_ACCESS_KEY_ID=your-access-key-id
# S3 访问密钥（请妥善保管，切勿泄露）
S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3 存储桶所在区域
S3_REGION=us-east-1
# 是否强制使用路径风格访问（Backblaze B2 / MinIO 等兼容服务需设置为 true）
S3_FORCE_PATH_STYLE=true

# ============================================
# MongoDB 数据库配置
# ============================================

# MongoDB 连接字符串
MONGODB_URI=mongodb://localhost:27017/s3-image-hub

# ============================================
# 认证配置
# ============================================

# JWT 签名密钥（生产环境请替换为足够长的随机字符串）
JWT_SECRET=replace-with-a-random-secret-string
# 初始管理员账号用户名
ADMIN_USERNAME=admin
# 初始管理员账号密码（生产环境请使用强密码）
ADMIN_PASSWORD=replace-with-a-strong-password

# ============================================
# 服务配置
# ============================================

# 服务监听端口
PORT=3000
# 对外访问的基础 URL（用于生成静态文件访问链接）,
BASE_URL=http://localhost:3000
